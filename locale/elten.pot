msgstr ""

#: src/scenes/welcome_wizard.rb:664
msgctxt "WelcomeWizard"
msgid ""
"Enter a date only if you want to replace the value that could not be read. Oth"
"erwise, leave it unchanged and review your profile later."
msgstr ""

#: src/scenes/welcome_wizard.rb:666
msgctxt "WelcomeWizard"
msgid "Change this date only if it is incorrect."
msgstr ""

#: src/scenes/welcome_wizard.rb:668
msgctxt "WelcomeWizard"
msgid ""
"This date lies outside the range the wizard expects, which is 1900 to 2013. Pl"
"ease check that it is correct before continuing."
msgstr ""

#: src/scenes/welcome_wizard.rb:670
msgctxt "WelcomeWizard"
msgid ""
"A date of birth is optional. If you provide one, Elten will remind your contac"
"ts when your birthday approaches."
msgstr ""


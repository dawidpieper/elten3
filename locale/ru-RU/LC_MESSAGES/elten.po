msgctxt "Login"
msgid "Login failure."
msgstr "Ошибка входа."

#: src/scenes/login.rb:303
msgctxt "Login"
msgid "This account has not been activated. Enter the activation code from the e-mail message or request the message again."
msgstr "Эта учётная запись не активирована. Введите код активации из электронного письма или запросите его повторно."

#: src/scenes/login.rb:304
msgctxt "Login"
msgid "Activation code:"
msgstr "Код активации:"


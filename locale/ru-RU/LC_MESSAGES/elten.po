msgid "Activation could not be started for this account. It may already be active."
msgstr "Не удалось запустить активацию для этой учётной записи. Возможно, она уже активирована."

#: src/scenes/login.rb:330
msgctxt "Login"
msgid "Account activated. You can now log in."
msgstr "Учётная запись активирована. Теперь вы можете войти в систему."

#: src/scenes/login.rb:336
msgctxt "Login"
msgid "Activation failed."
msgstr "Активация не удалась."

#: src/scenes/login.rb:339
msgctxt "Login"
msgid "The activation code you entered is incorrect. Please try again."
msgstr "Введённый код активации неверен. Попытайтесь снова."

#: src/scenes/login.rb:353
msgctxt "Login"
msgid "Do you want to encrypt this key with a custom PIN? You will be prompted for this PIN every time you start Elten to unlock your account. It will not be saved on the server and will apply only to the auto-login key stored on this device."
msgstr "Вы хотите зашифровать этот ключ с помощью пользовательского пин-кода? Вам будет предложено вводить код каждый раз, когда вы запускаете Elten, чтобы разблокировать вашу учётную запись, но он не  сохранится на сервере и будет действителен только для ключа автоматического входа, хранящегося на этом устройстве."

#: src/scenes/login.rb:358
msgctxt "Login"
msgid "Enter PIN again"
msgstr "Введите пинкод ещё раз"

#: src/scenes/login.rb:363
msgctxt "Login"

#: src/scenes/welcome_wizard.rb:1122
msgctxt "WelcomeWizard"
msgid ""
"A donation can be made by bank transfer using the details below. Mentioning "
"Elten in the transfer title helps the foundation account for the donation "
"correctly."
msgstr ""
"Darowiznę można przekazać przelewem bankowym, korzystając z poniższych "
"danych."

#: src/scenes/welcome_wizard.rb:1124 src/scenes/welcome_wizard.rb:1127

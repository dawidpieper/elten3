#: src/eapi/common/media.rb:24
msgctxt "EAPI_Common"
msgid ""
"You are trying to play a MIDI file. Elten needs an external instrument sound "
"bank to play MIDI files. Do you want to download it from the server now? "
"This may take several minutes."
msgstr ""
"Próbujesz odtworzyć plik typu midi. Aby poprawnie odtwarzać pliki tego typu, "
"program Elten wymaga zewnętrznej bazy brzmień instrumentów. Czy chcesz ją "
"teraz pobrać z serwera? To może potrwać kilka minut."

#: src/eapi/common/media.rb:25
msgctxt "EAPI_Common"
msgid "Please wait, the soundfont is being downloaded. It may take a while."
msgstr ""
"Proszę czekać, trwa pobieranie bazy brzmień midi. To może potrwać kilka "
"minut."

#: src/eapi/common/media.rb:27

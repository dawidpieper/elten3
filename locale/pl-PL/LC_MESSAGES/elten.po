msgstr "Usuń wizytówkę"

#: src/scenes/welcome_wizard.rb:1529
msgctxt "WelcomeWizard"
msgid "Replace the visiting card"
msgstr "Zastąp wizytówkę"

#: src/scenes/welcome_wizard.rb:1534
msgctxt "WelcomeWizard"
msgid "Remove the status"
msgstr "Usuń status"

#: src/scenes/welcome_wizard.rb:1536
msgctxt "WelcomeWizard"
msgid "Set the status to %{status}"
msgstr "Ustaw status na %{status}"

#: src/scenes/welcome_wizard.rb:1541
msgctxt "WelcomeWizard"
msgid "Remove the forum signature"
msgstr "Usuń sygnaturę na forum"

#: src/scenes/welcome_wizard.rb:1543
msgctxt "WelcomeWizard"
msgid "Set the forum signature to %{signature}"
msgstr "Ustaw sygnaturę na forum na %{signature}"

#: src/scenes/welcome_wizard.rb:1546
msgctxt "WelcomeWizard"
msgid "Set the main language to %{language}"
msgstr "Ustaw język główny na %{language}"

#: src/scenes/welcome_wizard.rb:1548
msgctxt "WelcomeWizard"
msgid "Set additional languages to %{languages}"
msgstr "Ustaw dodatkowe języki na %{languages}"

#: src/scenes/welcome_wizard.rb:1552
msgctxt "WelcomeWizard"
msgid "Join forum groups: %{groups}"
msgstr "Dołącz do grup na forum: %{groups}"

#: src/scenes/welcome_wizard.rb:1554
msgctxt "WelcomeWizard"
msgid "Publish a post in the introductions thread"
msgstr "Opublikuj wpis w wątku powitalnym"

#: src/scenes/welcome_wizard.rb:1557
msgctxt "WelcomeWizard"
msgid "Follow %{count} blog"
msgid_plural "Follow %{count} blogs"
msgstr[0] "Zacznij śledzić %{count} blog"
msgstr[1] "Zacznij śledzić %{count} blogi"
msgstr[2] "Zacznij śledzić %{count} blogów"

#: src/scenes/welcome_wizard.rb:1561
msgctxt "WelcomeWizard"
msgid "Follow %{count} person on the feed"
msgid_plural "Follow %{count} people on the feed"
msgstr[0] "Zacznij śledzić %{count} osobę na tablicy"
msgstr[1] "Zacznij śledzić %{count} osoby na tablicy"
msgstr[2] "Zacznij śledzić %{count} osób na tablicy"

#: src/scenes/welcome_wizard.rb:1563 src/scenes/welcome_wizard.rb:1740
msgctxt "WelcomeWizard"
msgid "Publish a feed entry"
msgstr "Opublikuj wpis na tablicy"

#: src/scenes/welcome_wizard.rb:1564
msgctxt "WelcomeWizard"
msgid "Change the macOS keyboard style"
msgstr "Zmień styl klawiatury w systemie macOS"

#: src/scenes/welcome_wizard.rb:1565
msgctxt "WelcomeWizard"
msgid "Change character navigation behaviour"
msgstr "Zmień sposób nawigacji po znakach"

#: src/scenes/welcome_wizard.rb:1566
msgctxt "WelcomeWizard"
msgid "Change the Invisible Interface modifier keys"
msgstr "Zmień klawisze modyfikatorów niewidzialnego interfejsu"

#: src/scenes/welcome_wizard.rb:1567
msgctxt "WelcomeWizard"
msgid "Change when audio content plays automatically"
msgstr "Zmień warunki automatycznego odtwarzania zawartości audio"

#: src/scenes/welcome_wizard.rb:1568
msgctxt "WelcomeWizard"
msgid "Change the tabs shown in the main window"
msgstr "Zmień karty wyświetlane w oknie głównym"

#: src/scenes/welcome_wizard.rb:1571
msgctxt "WelcomeWizard"
msgid "Always show the notifications tab"
msgstr "Zawsze pokazuj kartę powiadomień"

#: src/scenes/welcome_wizard.rb:1573
msgctxt "WelcomeWizard"
msgid "Hide the notifications tab when it is empty"
msgstr "Ukrywaj kartę powiadomień, gdy jest pusta"

#: src/scenes/welcome_wizard.rb:1576
msgctxt "WelcomeWizard"
msgid "Change how the notifications tab takes focus"
msgstr "Zmień sposób przenoszenia fokusu na kartę powiadomień"

#: src/scenes/welcome_wizard.rb:1577

#: src/scenes/registration.rb:23
msgctxt "Registration"
msgid ""
"Enter your username. It must contain between 3 and 32 characters, including "
"at least one letter. You may use letters, numbers, dots, hyphens, and "
"underscores."
msgstr ""
"Geben Sie Ihren Benutzernamen ein. Er muss zwischen 3 und 32 Zeichen lang "
"sein und mindestens einen Buchstaben enthalten. Sie können Buchstaben, "
"Zahlen, Punkte, Bindestriche und Unterstriche verwenden."

#: src/scenes/registration.rb:26 src/scenes/registration.rb:39
#: src/scenes/registration.rb:90
msgctxt "Registration"
msgid "This username is forbidden."
msgstr "Dieser Benutzername ist nicht zulässig."


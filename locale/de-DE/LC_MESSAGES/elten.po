msgctxt "Login"
msgid "Do not ask again"
msgstr "Nicht mehr nachfragen"

#: src/scenes/login.rb:190
msgctxt "Login"
msgid "Do you want to enable auto log in for account %{user}?"
msgstr ""
"Möchten Sie die automatische Anmeldung für das Konto %{user} aktivieren?"


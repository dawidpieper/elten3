file(READ "${ROOT}/locale/elten.pot" template)
string(REPLACE "\r\n" "\n" template "${template}")
string(SHA256 digest "${template}")
set(inputs "elten.pot ${digest}\n")
file(GLOB catalogues RELATIVE "${ROOT}/locale" "${ROOT}/locale/*/LC_MESSAGES/elten.mo")
foreach(name IN LISTS catalogues)
  file(SHA256 "${ROOT}/locale/${name}" digest)
  string(APPEND inputs "${name} ${digest}\n")
endforeach()
string(SHA256 current "${inputs}")

file(READ "${ROOT}/resources/translation-coverage.json" snapshot)
string(JSON cached GET "${snapshot}" inputs)
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
if(current STREQUAL cached)
  file(COPY_FILE "${ROOT}/resources/translation-coverage.json" "${OUTPUT}")
else()
  find_program(host_ruby NAMES ruby)
  if(host_ruby)
    execute_process(COMMAND "${host_ruby}" "${ROOT}/tools/translation-coverage.rb" "${ROOT}/locale" "${OUTPUT}"
                    RESULT_VARIABLE result)
  endif()
  if(NOT host_ruby OR NOT result STREQUAL "0")
    message(FATAL_ERROR "The translation catalogues have changed. Refresh resources/translation-coverage.json with 'ruby tools/translation-coverage.rb' using the gettext gem, or make Ruby with gettext available on the build host.")
  endif()
endif()
